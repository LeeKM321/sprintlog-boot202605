# SprintLog GraphQL 스키마 — "무엇을 물을 수 있는가" 의 목록(메뉴판).
# 클라이언트는 여기 적힌 필드 중 필요한 것만 골라 묻는다. 여기 없는 필드는 절대 나가지 않는다.

"읽기 — 조회의 시작점"
type Query {
    "활동 목록. 조건은 하나만 쓴다(종류 → 키워드 → 최소 시간 순으로 먼저 온 것)"
    activities(category: ActivityCategory, keyword: String, minMinutes: Int): [Activity!]!

    "활동 한 건"
    activity(id: ID!): Activity
}

"쓰기 — 등록·수정·삭제의 시작점"
type Mutation {
    "활동 등록 — 로그인한 사람이 주인이 된다"
    createActivity(input: CreateActivityInput!): Activity!

    "활동 수정(제목·공개 여부) — 주인이나 관리자만"
    updateActivity(id: ID!, input: UpdateActivityInput!): Activity!

    "활동 삭제 — 주인이나 관리자만. 지웠으면 true"
    deleteActivity(id: ID!): Boolean!
}

"활동 등록에 넣는 값 — 입력 전용 타입은 type 이 아니라 input 으로 쓴다"
input CreateActivityInput {
    category: ActivityCategory!
    title: String!
    minutes: Int!
    visibility: Visibility!
    tags: [String!]
    "공부한 날(2026-10-08 모양). 안 주면 오늘"
    studiedOn: String
    instructorName: String
    completionRate: Int
    bookTitle: String
}

"활동 수정에 넣는 값"
input UpdateActivityInput {
    title: String!
    visibility: Visibility!
}


"학습 활동 한 건"
type Activity {
    id: ID!
    title: String!
    minutes: Int!
    category: ActivityCategory!
    visibility: Visibility!
    tags: [String!]!
    "공부한 날(2026-10-08 모양의 글자)"
    studiedOn: String
    "강의일 때만"
    instructorName: String
    "실습일 때만(0~100)"
    completionRate: Int
    "독서일 때만"
    bookTitle: String
    "기록한 사람"
    owner: User
}

"사용자 — 공개해도 되는 것만 적는다"
type User {
    id: ID!
    nickname: String!
}

enum ActivityCategory {
    LECTURE
    PRACTICE
    READING
}

enum Visibility {
    PUBLIC
    PRIVATE
}
