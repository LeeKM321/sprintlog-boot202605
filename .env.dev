
# 환경변수를 상황에 따라 다르게 적용하고 싶을 때에는 .env로 시작하는 파일을 여러 개 작성할 수 있습니다.
# --env-file 옵션을 통해서 원하는 env 파일을 up 할때 지정할 수 있습니다.
# docker compose --env-file .env.dev up -d

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sprintlog
SPRING_DATASOURCE_PASSWORD=merong
JPA_DDL_AUTO=create


POSTGRES_DB=sprintlog
POSTGRES_PASSWORD=secret
